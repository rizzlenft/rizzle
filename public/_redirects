# Cloudflare Pages / Netlify SPA fallback.
#
# This site is a single-page React app routed by react-router-dom. When a user
# hits a direct URL like https://rizzle.io/games or refreshes on /guests, the
# static host needs to serve index.html (which boots React, which then renders
# the right route) rather than returning a 404.
#
# This rule says: for any request that does NOT match a real static file,
# serve /index.html with a 200 status. Real assets (e.g. /games/rizzle-dash.html,
# /og/og-home.jpg, /favicon.ico, /assets/*) are served as-is because they exist.
#
# Whack-a-Mole is a separate client-side SPA under /games/whack-a-mole/ — its
# in-game /leaderboard route must boot the game shell, not the main React app.

/games/whack-a-mole                  /games/whack-a-mole/index.html   200
/games/whack-a-mole/                 /games/whack-a-mole/index.html   200
/games/whack-a-mole/leaderboard      /games/whack-a-mole/index.html   200

# Rizzle Dash: Cloudflare Pages already serves rizzle-dash.html at /games/rizzle-dash.
# Do NOT rewrite that path back to .html — it causes ERR_TOO_MANY_REDIRECTS.
/games/rizzle-dash/                  /games/rizzle-dash               301
/rizzledash                          /games/rizzle-dash               301

