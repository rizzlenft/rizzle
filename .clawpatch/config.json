{
  "schemaVersion": 1,
  "stateDir": ".clawpatch",
  "include": ["**/*"],
  "exclude": [
    "node_modules/**",
    "dist/**",
    "build/**",
    ".git/**",
    ".clawpatch/**",
    "public/games/rizzle-dash.html",
    "public/games/capyrizzle/game.js",
    "public/games/whack-a-mole/**"
  ],
  "provider": {
    "name": "cursor",
    "model": null
  },
  "commands": {
    "typecheck": "npm run typecheck",
    "lint": "npm run lint",
    "format": null,
    "test": "npm run test",
    "build": "npm run build"
  },
  "review": {
    "maxContextFiles": 24,
    "maxOwnedFiles": 12,
    "maxFindingsPerFeature": 10,
    "minConfidenceToFix": "medium"
  },
  "git": {
    "requireCleanWorktreeForFix": true,
    "commit": false,
    "openPr": false
  }
}
