lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment files. The currently tracked .env contains only the
# Supabase publishable (anon) key, which is safe to be public — but this
# rule prevents accidentally committing any real secret added later.
.env
.env.local
.env.*.local

# Local one-time migration scratchpad. Contains data exports from the old
# Lovable-owned Supabase project (game_scores, etc.) and generated SQL we
# paste into the new (rizzlenft-owned) project during cutover. Not source
# code — should never be committed.
.migration-backup/

