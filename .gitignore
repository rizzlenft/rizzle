# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# Local environment files. The currently tracked .env contains only the
# Supabase publishable (anon) key, which is safe to be public — but this
# rule prevents accidentally committing any real secret added later.
.env
.env.local
.env.*.local

# Local one-time migration scratchpad. Contains data exports from the old
# Lovable-owned Supabase project (game_scores, etc.) and generated SQL we
# paste into the new (rizzlenft-owned) project during cutover. Not source
# code — should never be committed.
.migration-backup/

# Supabase CLI's local cache (project ref, gotrue version, postgres version,
# etc.). Recreated on every `supabase link`. Never belongs in git.
supabase/.temp/

# clawpatch local review/fix state (generated)
.clawpatch/*
!.clawpatch/config.json
clawpatch-report*.md

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
