# Copy to .env for local development.
# Production builds use the committed .env (Supabase anon key only — safe to be public).
# You can override via Cloudflare Pages → Settings → Variables and secrets instead.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key_here

# Optional (baked at build time). Enables Turnstile widget on the contact form.
# VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# --- Cloudflare Pages Function secrets (NOT Vite; set in CF dashboard for Production) ---
# Required for /api/contact (Resend):
# RESEND_API_KEY=re_xxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Rizzle <onboarding@resend.dev>   # must be a verified Resend sender/domain
# Optional Turnstile verification:
# TURNSTILE_SECRET_KEY=your_turnstile_secret
